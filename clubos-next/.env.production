# URLs de la API en producción. Next.js las lee automático en cada build
# (`next build`), sin necesidad de configurarlas en el panel de Vercel.
# No son secretas: son la URL pública del propio backend.
#
# NEXT_PUBLIC_API_URL: usada por el cliente (navegador) para pegarle directo
# al backend en llamadas cross-origin (agenda, portal público del jugador).
NEXT_PUBLIC_API_URL=https://padel-production-f5ff.up.railway.app/api/v1

# API_URL: usada solo en next.config.mjs (rewrites, server-side) para
# proxyear /api/:path* al backend desde el mismo origen — así la cookie
# httpOnly del refresh token del login de staff viaja same-origin, sin
# problemas de cookies de terceros. Sin barra final, sin /api/v1: el rewrite
# ya arma el path completo.
API_URL=https://padel-production-f5ff.up.railway.app
