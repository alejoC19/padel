# ============================================================================
# ClubOS API — variables de entorno
# Copiá este archivo a .env y completá los valores.
# ============================================================================

NODE_ENV=development
PORT=3001

# URL pública de ESTE backend (la usan los webhooks y el callback de OAuth).
# En dev con MP necesitás un túnel (ngrok/cloudflared) porque MP debe poder
# llegar a tu máquina desde internet. Ej: https://abcd-1234.ngrok-free.app
API_PUBLIC_URL=http://localhost:3001

# URL pública del frontend (Next.js).
WEB_PUBLIC_URL=http://localhost:3000

# Base de datos
#
# DATABASE_URL: rol restringido `clubos_app` (creado por db/init/02-app-role.sql).
# Lo usa el backend en runtime. Sujeto a Row-Level Security: NUNCA usar el
# owner acá, o RLS queda bypasseada y un club puede leer datos de otro.
DATABASE_URL=postgresql://clubos_app:clubos_dev@localhost:5432/clubos?schema=public
# DIRECT_URL: rol owner. Solo lo usa `prisma migrate`/`db push` para DDL
# (crear tablas, índices). clubos_app no tiene esos permisos a propósito.
DIRECT_URL=postgresql://clubos_owner:clubos_dev@localhost:5432/clubos?schema=public

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:3000

# ---- Auth ----
JWT_ACCESS_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL=900          # segundos (15 min)
REFRESH_TOKEN_TTL_DAYS=30
LOG_QUERIES=false

# ============================================================================
# PAGOS — Mercado Pago (marketplace)
# ============================================================================
# App creada en https://www.mercadopago.com.ar/developers → "Tus integraciones"
# Modelo marketplace: cada club conecta SU cuenta vía OAuth. Estas credenciales
# son las de TU aplicación (la plataforma), no las de ningún club.
MP_APP_ID=
MP_APP_SECRET=

# Secreto para verificar la firma de los webhooks (panel de MP → Webhooks).
#
# ⚠️  EN PRODUCCIÓN ES OBLIGATORIO y tiene que ser EXACTAMENTE el secreto que
# figura en tu panel de Mercado Pago → Tus integraciones → Webhooks → Firma
# secreta. Si lo dejás vacío, cada club conectado se queda con un secreto
# generado localmente (solo para no romper el flujo en dev): la verificación
# de firma va a fallar SIEMPRE contra webhooks reales de MP, así que ningún
# pago se va a confirmar por webhook (el webhook lo rechaza sin procesar).
MP_WEBHOOK_SECRET=

# Secreto para firmar el `state` del OAuth (anti-CSRF). Si no lo ponés, se usa
# PAYMENTS_ENC_KEY. Generá uno con: openssl rand -base64 32
MP_STATE_SECRET=

# ---- Cifrado de secretos de terceros ----
# Con esta clave se cifran los tokens de MP de cada club (AES-256-GCM).
# MÍNIMO 32 caracteres. Generá una con: openssl rand -base64 48
# ⚠️  Si la perdés, todos los clubes tienen que reconectar Mercado Pago.
PAYMENTS_ENC_KEY=

# ============================================================================
# NOTIFICACIONES — WhatsApp (Meta Cloud API) y email (Resend)
# ============================================================================
# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp)
# Requiere número verificado y plantillas aprobadas por Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=es_AR

# Email transaccional (https://resend.com). El From debe ser de un dominio
# verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=ClubOS <hola@tudominio.com.ar>

# ============================================================================
# PRODUCCIÓN — observabilidad y backups
# ============================================================================
# Error tracking (opcional). Si está, los 5xx se reportan a Sentry.
# Requiere: npm i @sentry/node y descomentar el init en error-reporter.ts
SENTRY_DSN=
APP_VERSION=

# Backups (usados por scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Para subir a S3 (opcional; requiere aws cli con credenciales en el entorno):
BACKUP_S3_BUCKET=
