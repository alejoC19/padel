{
  "name": "clubos-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPattern=\\.spec\\.ts$",
    "test:int": "jest --testPathPattern=\\.int-spec\\.ts$ --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && npm run db:manual",
    "db:manual": "psql $DATABASE_URL -v ON_ERROR_STOP=1 -f prisma/manual/001_integrity_and_rls.sql",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:manual && npm run db:seed",
    "verify:rotation": "node scripts/verify-rotation.cjs",
    "verify:time": "node scripts/verify-time.cjs",
    "verify:agenda": "node scripts/verify-agenda.cjs",
    "verify": "npm run verify:rotation && npm run verify:time && npm run verify:agenda && npm run verify:money && npm run verify:cash && npm run verify:pos && npm run verify:brackets",
    "verify:money": "node scripts/verify-money.cjs",
    "db:up": "docker compose up -d db redis",
    "db:down": "docker compose down",
    "smoke": "node scripts/smoke-test.mjs",
    "db:setup": "npm run db:up && sleep 5 && npx prisma migrate deploy && npm run db:manual && npm run db:seed",
    "verify:cash": "node scripts/verify-cash.cjs",
    "verify:pos": "node scripts/verify-pos.cjs",
    "verify:brackets": "node scripts/verify-brackets.cjs",
    "e2e": "node scripts/e2e-day.mjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "@types/pg": "^8.11.10"
  }
}